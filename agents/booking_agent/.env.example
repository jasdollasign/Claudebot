# Copy this to .env and fill in your values
# .env is gitignored – never commit real credentials

# A Gmail address used ONLY for sending (must NOT be fprioai@gmail.com)
# e.g. bookings.noreply@gmail.com
GMAIL_USER=your_sender@gmail.com

# 16-character App Password (Gmail → Security → 2-Step → App Passwords)
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# Destination that receives all booking notifications
NOTIFY_EMAIL=fprioai@gmail.com
