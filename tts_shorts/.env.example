# ── Required ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── TTS Settings ─────────────────────────────────────────────────────────────
# Run `edge-tts --list-voices` for all available voices
# Popular choices:
#   en-US-AriaNeural      (female, warm — default)
#   en-US-GuyNeural       (male, clear)
#   en-US-JennyNeural     (female, friendly)
#   en-GB-SoniaNeural     (British female)
TTS_VOICE=en-US-AriaNeural

# Speaking rate: -50% (slow) to +100% (fast)
TTS_RATE=+10%

# Volume: -50% to +50%
TTS_VOLUME=+0%

# Words shown per caption chunk (3-5 works best)
WORDS_PER_CHUNK=4

# ── YouTube Upload (only needed for --upload flag) ────────────────────────────
# Path to OAuth2 client secrets JSON from Google Cloud Console
YOUTUBE_CLIENT_SECRETS=client_secrets.json

# Where to store the OAuth2 token after first login (auto-created)
YOUTUBE_CREDENTIALS=.youtube_token.json

# Privacy for uploaded videos: private | unlisted | public
# Start with "private" to review before publishing!
YOUTUBE_PRIVACY=private
