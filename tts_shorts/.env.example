# ── Required: pick ONE provider ──────────────────────────────────────────────
# Option A — Anthropic direct (key starts with sk-ant-)
ANTHROPIC_API_KEY=

# Option B — OpenRouter (key starts with sk-or-)
# Routes to Claude models, often cheaper, supports many other models too.
OPENROUTER_API_KEY=

# Optional: override the default models
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ── TTS Settings ─────────────────────────────────────────────────────────────
# Run `edge-tts --list-voices` for all available voices
# Popular: en-US-AriaNeural (default), en-US-GuyNeural, en-US-JennyNeural,
#          en-GB-SoniaNeural, en-AU-NatashaNeural
TTS_VOICE=en-US-AriaNeural

# Speaking rate: -50% (slow) to +100% (fast)
TTS_RATE=+10%

# Volume: -50% to +50%
TTS_VOLUME=+0%

# Words shown per caption chunk (3-5 works best)
WORDS_PER_CHUNK=4

# ── YouTube Upload (only needed for --upload flag) ────────────────────────────
YOUTUBE_CLIENT_SECRETS=client_secrets.json
YOUTUBE_CREDENTIALS=.youtube_token.json
YOUTUBE_PRIVACY=private
